# Kopyala: cp .env.example .env  — .env ASLA commit edilmez.
# F0-F3 dry-run için anahtar GEREKMEZ (boş bırak, bot public veriyle simüle eder).
# Canlı paper/testnet aşamasında doldur; Binance'te withdraw yetkisi ASLA açma, IP whitelist kullan.

# Freqtrade bu env değişkenlerini config'in üstüne yazar:
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Telegram raporlama (opsiyonel, F3)
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Hat A — Alpaca paper (F6)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
