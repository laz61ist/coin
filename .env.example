# Kopyala: cp .env.example .env  — .env ASLA commit edilmez.
# F0-F3 dry-run için anahtar GEREKMEZ (boş bırak, bot public veriyle simüle eder).
# Canlı paper/testnet aşamasında doldur; Binance'te withdraw yetkisi ASLA açma, IP whitelist kullan.

# Freqtrade bu env değişkenlerini config'in üstüne yazar:
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Web arayüzü (opsiyonel; varsayılan kapalı — açarsan üçünü de doldur)
FREQTRADE__API_SERVER__ENABLED=false
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# Telegram raporlama (opsiyonel, F3)
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# F4 — LLM karar destek katmanı (shadow mode; llm_advisor/)
ANTHROPIC_API_KEY=
# Model kademesi (opsiyonel; varsayılanlar anayasa §2.1a'ya göre)
TC_LLM_BRIEF_MODEL=claude-haiku-4-5
TC_LLM_VETO_MODEL=claude-sonnet-5
TC_LLM_REVIEW_MODEL=claude-opus-4-8

# Hat A — Alpaca paper (F6)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
